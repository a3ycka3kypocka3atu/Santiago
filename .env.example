# Lumeya dedicated Supabase project
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Public deployment
PUBLIC_SITE_URL=https://your-public-site.example

# Server/bot only. Never expose these values in browser code.
BOT_TOKEN=your_botfather_token
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ADMIN_CHAT_ID=your_numeric_telegram_chat_id

# Optional worker configuration
PUBLIC_REQUEST_POLL_MS=60000
NOTIFICATION_TIME_ZONE=Europe/Prague
